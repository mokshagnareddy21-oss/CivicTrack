# ====================================================================
# CivicTrack - Public Grievance Tracker Environment Configuration
# ====================================================================

# MongoDB Atlas Connection URI
# If provided, CivicTrack connects directly to your MongoDB Atlas cluster.
# If omitted during development, an in-memory MongoDB instance is initialized so the app runs immediately.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/civictrack?retryWrites=true&w=majority"

# JWT Secret key for signing and verifying JSON Web Tokens
JWT_SECRET="civictrack_super_secure_jwt_secret_key_2026_dev_prod"

# Node.js Server Port (default 3000)
PORT=3000

# Default Administrator Seed Credentials
# Automatically created on database startup if no admin exists
DEFAULT_ADMIN_EMAIL="admin@civictrack.gov"
DEFAULT_ADMIN_PASSWORD="Admin@CivicTrack2026"
DEFAULT_ADMIN_NAME="State Grievance Administrator"
DEFAULT_ADMIN_PHONE="+1 (555) 019-2831"

# Application URL
APP_URL="http://localhost:3000"
